{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terminus.local/xi/admission-policy.schema.json",
  "title": "Terminus XI Admission Policy v1",
  "description": "Boundary admission policy. ERROR and FAIL handling is not configurable: any ERROR result yields ERROR and any FAIL result yields REJECT. Only WARN handling is a policy choice, and it must be stated explicitly.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_id", "version", "on_warn"],
  "properties": {
    "schema": {"const": "terminus-xi.admission-policy.v1"},
    "policy_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "required_checks": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "on_warn": {"enum": ["ADMIT", "REVIEW", "REJECT"]}
  }
}
