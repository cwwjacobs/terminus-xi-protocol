{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terminus.local/xi/check-contract-set.schema.json",
  "title": "Terminus XI Check Contract Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "set_id", "version", "contracts"],
  "properties": {
    "schema": {"const": "terminus-xi.check-contract-set.v1"},
    "set_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {"$ref": "check-contract.schema.json"},
          {"$ref": "check-contract.v2.schema.json"}
        ]
      }
    }
  }
}
