{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terminus.local/proof/demo-spec.schema.json",
  "title": "Terminus Proof Demo Specification v1",
  "description": "Declarative description of one baseline-vs-capability proof run. The spec declares intent and identity only; it never declares a result. Every outcome in the emitted package is produced by executing the arms and submitting the evidence to frozen XI v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "demo_id",
    "title",
    "claim",
    "changed_variable",
    "fixture",
    "model",
    "tool_surface",
    "arms",
    "checks",
    "redaction",
    "render"
  ],
  "properties": {
    "schema": {
      "const": "terminus-proof.demo-spec.v1"
    },
    "demo_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "version"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "scope",
        "kind"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "delta"
          ]
        },
        "not_claimed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "changed_variable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "baseline_value",
        "augmented_value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "baseline_value": {},
        "augmented_value": {},
        "description": {
          "type": "string"
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "path"
      ],
      "properties": {
        "fixture_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model_id"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object"
        }
      }
    },
    "tool_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools"
      ],
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "arms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "augmented"
      ],
      "properties": {
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "arm_id",
            "adapter",
            "config"
          ],
          "properties": {
            "arm_id": {
              "type": "string",
              "minLength": 1
            },
            "adapter": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "path"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "fixture-recording"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "config": {
              "type": "object",
              "minProperties": 1
            }
          }
        },
        "augmented": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "arm_id",
            "adapter",
            "config"
          ],
          "properties": {
            "arm_id": {
              "type": "string",
              "minLength": 1
            },
            "adapter": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "path"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "fixture-recording"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "config": {
              "type": "object",
              "minProperties": 1
            }
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm_contract_set",
        "arm_policy",
        "package_contract_set",
        "package_policy"
      ],
      "properties": {
        "arm_contract_set": {
          "type": "string",
          "minLength": 1
        },
        "arm_policy": {
          "type": "string",
          "minLength": 1
        },
        "package_contract_set": {
          "type": "string",
          "minLength": 1
        },
        "package_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subtitle",
        "labels"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline",
            "augmented",
            "contract",
            "verdict",
            "receipt"
          ],
          "properties": {
            "baseline": {
              "type": "string",
              "minLength": 1
            },
            "augmented": {
              "type": "string",
              "minLength": 1
            },
            "contract": {
              "type": "string",
              "minLength": 1
            },
            "verdict": {
              "type": "string",
              "minLength": 1
            },
            "receipt": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
