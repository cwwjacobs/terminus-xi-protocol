{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terminus.local/proof/evidence-bundle.schema.json",
  "title": "Terminus Proof Arm Evidence Bundle v1",
  "description": "The public-safe evidence produced by one execution arm. Identity fields (model, fixture, tool surface, effective config) are recorded by the adapter from the execution itself, not copied from the spec, so parity is proved from evidence rather than assumed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "arm_id",
    "capability_enabled",
    "model",
    "fixture",
    "tool_surface",
    "config",
    "evidence_available",
    "output",
    "transcript",
    "raw_sha256",
    "redaction"
  ],
  "properties": {
    "schema": {"const": "terminus-proof.evidence-bundle.v1"},
    "arm_id": {"type": "string", "minLength": 1},
    "capability_enabled": {"type": "boolean"},
    "capability": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["capability_id", "version"],
      "properties": {
        "capability_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source": {"type": ["string", "null"]}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model_id", "params_sha256"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "params_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "sha256"],
      "properties": {
        "fixture_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "tool_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools", "sha256"],
      "properties": {
        "tools": {"type": "array", "items": {"type": "string"}},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "config": {"type": "object", "minProperties": 1},
    "evidence_available": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "sha256", "summary"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "declared_gaps": {"type": "array", "items": {"type": "string"}},
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claims", "limitations"],
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim_id", "statement"],
            "properties": {
              "claim_id": {"type": "string", "minLength": 1},
              "statement": {"type": "string", "minLength": 1},
              "scope": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "properties": {
                  "asset_scope": {"type": "string"},
                  "time_window": {"type": "string"},
                  "surface": {"type": "string"}
                }
              },
              "evidence_refs": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "transcript": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "role", "text"],
        "properties": {
          "step": {"type": "integer", "minimum": 1},
          "role": {"enum": ["task", "tool", "model", "capability"]},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version", "policy_sha256", "applied_rules", "unapplied_rules"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "applied_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule_id", "hits"],
            "properties": {
              "rule_id": {"type": "string", "minLength": 1},
              "hits": {"type": "integer", "minimum": 0}
            }
          }
        },
        "unapplied_rules": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
