{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terminus.local/proof/findings.schema.json",
  "title": "Terminus Proof Findings Index v1",
  "description": "Every typed finding produced at every boundary of one proof build, flattened for reading. This file is a projection of the receipts; the receipts remain authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "proof_id", "boundaries"],
  "properties": {
    "schema": {"const": "terminus-proof.findings.v1"},
    "proof_id": {"type": "string", "minLength": 1},
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["boundary_id", "admission", "receipt_sha256", "results"],
        "properties": {
          "boundary_id": {"type": "string", "minLength": 1},
          "admission": {"enum": ["ADMIT", "REJECT", "REVIEW", "ERROR"]},
          "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "results": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["check_id", "check_version", "verdict", "findings"],
              "properties": {
                "check_id": {"type": "string", "minLength": 1},
                "check_version": {"type": "string", "minLength": 1},
                "verdict": {"enum": ["PASS", "WARN", "FAIL", "ERROR"]},
                "findings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["code", "severity", "message"],
                    "properties": {
                      "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
                      "severity": {"enum": ["INFO", "WARN", "FAIL", "ERROR"]},
                      "message": {"type": "string"},
                      "evidence_ref": {"type": ["string", "null"]}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
