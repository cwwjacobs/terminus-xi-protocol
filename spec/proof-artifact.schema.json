{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terminus.local/proof/proof-artifact.schema.json",
  "title": "Terminus Proof Package Artifact v1",
  "description": "The single artifact submitted to the XI package boundary. It is fully deterministic: it contains no clock reading and no receipt digest, so identical inputs produce an identical artifact digest and therefore an identical proof id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "demo_id",
    "title",
    "spec_sha256",
    "claim",
    "changed_variable",
    "declared_gaps",
    "declared",
    "arms",
    "contract_sets",
    "policies",
    "redaction",
    "public_projection"
  ],
  "properties": {
    "schema": {
      "const": "terminus-proof.proof-artifact.v1"
    },
    "demo_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capability": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "capability_id",
        "version"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "scope",
        "kind",
        "not_claimed"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "delta"
          ]
        },
        "not_claimed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "changed_variable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "baseline_value",
        "augmented_value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "baseline_value": {},
        "augmented_value": {},
        "description": {
          "type": "string"
        }
      }
    },
    "declared_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "arms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "augmented"
      ],
      "properties": {
        "baseline": {
          "$ref": "proof-arm.schema.json"
        },
        "augmented": {
          "$ref": "proof-arm.schema.json"
        }
      }
    },
    "contract_sets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm",
        "package"
      ],
      "properties": {
        "arm": {
          "$ref": "identified-document.schema.json"
        },
        "package": {
          "$ref": "identified-document.schema.json"
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm",
        "package"
      ],
      "properties": {
        "arm": {
          "$ref": "identified-document.schema.json"
        },
        "package": {
          "$ref": "identified-document.schema.json"
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "policy_sha256",
        "rule_ids",
        "deny_patterns"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rule_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny_patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pattern_id",
              "expression",
              "description"
            ],
            "properties": {
              "pattern_id": {
                "type": "string",
                "minLength": 1
              },
              "expression": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "public_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subtitle",
        "labels",
        "claim_statement",
        "claim_scope",
        "changed_variable",
        "arms",
        "contract_checks"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "labels": {
          "type": "object"
        },
        "claim_statement": {
          "type": "string",
          "minLength": 1
        },
        "claim_scope": {
          "type": "string",
          "minLength": 1
        },
        "changed_variable": {
          "type": "object"
        },
        "arms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline",
            "augmented"
          ],
          "properties": {
            "baseline": {
              "$ref": "projected-arm.schema.json"
            },
            "augmented": {
              "$ref": "projected-arm.schema.json"
            }
          }
        },
        "contract_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "title"
            ],
            "properties": {
              "check_id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "declared": {
      "type": "object",
      "description": "The surface the demo spec declared. Recorded so that a check can establish the emitted package is a proof about the specification it names.",
      "additionalProperties": false,
      "required": [
        "model",
        "tool_surface",
        "arms"
      ],
      "properties": {
        "model": {
          "type": "object"
        },
        "tool_surface": {
          "type": "object"
        },
        "arms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline",
            "augmented"
          ],
          "properties": {
            "baseline": {
              "type": "object",
              "required": [
                "arm_id",
                "config"
              ]
            },
            "augmented": {
              "type": "object",
              "required": [
                "arm_id",
                "config"
              ]
            }
          }
        }
      }
    }
  }
}
