{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terminus.local/proof/proof-manifest.schema.json",
  "title": "Terminus Proof Package Manifest v1",
  "description": "The completeness and integrity index of a proof directory. Verification requires that every listed file is present with the listed digest, that every required file is listed, and that the directory contains no unlisted file. Absence of a file, an extra file, and an edited file are all detectable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "proof_id", "state", "required_files", "files", "files_sha256"],
  "properties": {
    "schema": {"const": "terminus-proof.manifest.v1"},
    "proof_id": {"type": "string", "minLength": 1},
    "state": {"enum": ["ADMITTED", "NOT_ADMITTED"]},
    "admission": {"enum": ["ADMIT", "REJECT", "REVIEW", "ERROR"]},
    "engine_version": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string"},
    "required_files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "media_type": {"type": "string"}
        }
      }
    },
    "files_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
