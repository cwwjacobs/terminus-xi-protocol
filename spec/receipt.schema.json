{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terminus.local/xi/receipt.schema.json",
  "title": "Terminus XI Boundary Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "boundary_id", "artifact_sha256", "check_results", "admission", "protocol_version"],
  "properties": {
    "schema": {"const": "terminus-xi.receipt.v1"},
    "boundary_id": {"type": "string", "minLength": 1},
    "protocol_version": {"type": "string", "minLength": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "check_results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "watchdog-result.schema.json"}
    },
    "admission": {"enum": ["ADMIT", "REJECT", "REVIEW", "ERROR"]},
    "recovery_ref": {"type": ["string", "null"]},
    "parent_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}
