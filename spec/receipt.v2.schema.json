{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terminus.local/xi/receipt.v2.schema.json",
  "title": "Terminus XI Boundary Receipt v2",
  "description": "Deliberately versioned replacement for terminus-xi.receipt.v1. v1 had no place to bind provenance, contract-set identity, the admission rationale, or the receipt's own digest, all of which KSL-01 requires. check_results still use the unchanged terminus-xi.watchdog-result.v1 envelope. created_at_utc is the only temporal field and is excluded from stable_core_sha256.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "boundary_id", "protocol_version", "runtime_version", "created_at_utc", "artifact_sha256", "contract_set_sha256", "provenance", "check_results", "admission", "admission_rationale", "stable_core_sha256", "receipt_sha256"],
  "properties": {
    "schema": {"const": "terminus-xi.receipt.v2"},
    "boundary_id": {"type": "string", "minLength": 1},
    "protocol_version": {"type": "string", "minLength": 1},
    "runtime_version": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "minLength": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "contract_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance": {"$ref": "provenance.schema.json"},
    "check_results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "watchdog-result.schema.json"}
    },
    "admission": {"enum": ["ADMIT", "REJECT", "REVIEW", "ERROR"]},
    "admission_rationale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version", "on_warn", "blocking_codes", "reasons"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "on_warn": {"enum": ["ADMIT", "REVIEW", "REJECT"]},
        "blocking_codes": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "recovery_ref": {"type": ["string", "null"]},
    "parent_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "stable_core_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
