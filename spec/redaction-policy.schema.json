{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terminus.local/proof/redaction-policy.schema.json",
  "title": "Terminus Proof Redaction Policy v1",
  "description": "Public-safe projection policy. A policy carries rules (what to remove) and deny patterns (what must never survive). It never carries a secret literal, because the policy travels inside the published proof package and is read by a deterministic XI check.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_id", "version", "rules", "deny_patterns"],
  "properties": {
    "schema": {"const": "terminus-proof.redaction-policy.v1"},
    "policy_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "action", "match"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "description": {"type": "string"},
          "action": {"enum": ["mask", "drop"]},
          "match": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "expression"],
            "properties": {
              "kind": {"enum": ["regex", "pointer"]},
              "expression": {"type": "string", "minLength": 1}
            }
          },
          "required_hits": {"type": "integer", "minimum": 0}
        }
      }
    },
    "deny_patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern_id", "expression", "description"],
        "properties": {
          "pattern_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "expression": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
