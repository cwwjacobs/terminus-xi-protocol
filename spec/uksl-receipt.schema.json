{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terminus.local/uksl-receipt.schema.json",
  "title": "Terminus UKSL Closure Receipt v1",
  "description": "Machine-readable record of KSL-01 and KSL-02 closure. Each clause carries the observable evidence that establishes it, or an explicit blocker. A clause is never closed by assertion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "uksl_id", "created_at_utc", "protocol_version", "ksl", "tests", "known_limitations", "closed"],
  "properties": {
    "schema": {"const": "terminus.uksl-receipt.v1"},
    "uksl_id": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "minLength": 1},
    "protocol_version": {"type": "string", "minLength": 1},
    "runtime_version": {"type": "string", "minLength": 1},
    "engine_version": {"type": "string", "minLength": 1},
    "ksl": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ksl_id", "closed", "exit_gate"],
        "properties": {
          "ksl_id": {"type": "string", "minLength": 1},
          "closed": {"type": "boolean"},
          "freeze_receipt": {"type": ["string", "null"]},
          "freeze_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "proof_id": {"type": ["string", "null"]},
          "proof_dir": {"type": ["string", "null"]},
          "exit_gate": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["clause", "satisfied", "evidence"],
              "properties": {
                "clause": {"type": "string", "minLength": 1},
                "satisfied": {"type": "boolean"},
                "evidence": {"type": "string", "minLength": 1},
                "blocker": {"type": ["string", "null"]}
              }
            }
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "tests_run", "failures", "errors", "skipped", "passed"],
      "properties": {
        "command": {"type": "string"},
        "tests_run": {"type": "integer", "minimum": 0},
        "failures": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "passed": {"type": "boolean"}
      }
    },
    "media_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mp4", "png"],
      "properties": {
        "mp4": {"type": "object"},
        "png": {"type": "object"}
      }
    },
    "known_limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "unresolved_clauses": {"type": "array", "items": {"type": "string"}},
    "closed": {"type": "boolean"}
  }
}
